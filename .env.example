# Core application settings
PASM_PASSIVE_ONLY=true
ENABLE_AI_SUMMARY=false
EASM_DEBUG=true
EASM_HOST=127.0.0.1
EASM_PORT=5000

# Optional AI integration (free providers only)
# Examples of free or low-cost providers:
# - OpenRouter: https://openrouter.ai/keys
# - Groq: https://console.groq.com/keys
# - Hugging Face: https://huggingface.co/settings/tokens
FREE_AI_API_KEY=
FREE_AI_BASE_URL=https://openrouter.ai/api/v1
FREE_AI_MODEL=openai/gpt-oss-20b

# If you want to use a different provider later, set a compatible OpenAI-style API.
# The project only needs these variables to enable the optional AI assistant.
